# Copy this file to .env and update the values below

# Application Settings
APP_NAME=TARA-TRABAHO
APP_KEY=replace-with-a-random-64-character-hex-value
APP_ENV=production
APP_URL=https://your-domain.example

# Existing Navicat schema; after setting .env, run:
# php console/migrate-tara-trabaho.php
# Database Configuration
DB_DRIVER=mysql
DB_HOST=your-aiven-hostname
DB_PORT=12036
DB_USER=avnadmin
DB_PASSWORD=replace-with-a-new-rotated-password
DB_NAME=tara_trabaho
DB_CHARSET=utf8mb4
DB_PREFIX=
# Optional: path to the provider's CA certificate for verified TLS.
DB_SSL_CA=path-to-aiven-ca.pem

# SMTP email delivery
# Preferred on Render Free: Resend HTTPS API key (requires a verified sender domain).
RESEND_API_KEY=
# Presentation test mode only: use this with MAIL_FROM=onboarding@resend.dev.
# Resend will deliver only to the email associated with your Resend account.
RESEND_TEST_RECIPIENT=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=TARA-TRABAHO

# Cloudinary server-side credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional OpenAI skill-gap guidance; keep the API key server-side
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Browser push (generate with: php console/generate-vapid.php)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
API_ALLOWED_ORIGINS=https://tara-tarabaho-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
SESSION_COOKIE_SAMESITE=Lax
JWT_SECRET=generate-a-new-random-64-character-hex-value
REFRESH_TOKEN_KEY=generate-a-different-random-64-character-hex-value
